{
  "name": "deadlock-tactical-autobuild",
  "version": "2.0.1",
  "description": "Real-time build coach and overlay for Deadlock: reads the game screen and tells you what to buy next.",
  "author": "Pedro Gomes",
  "license": "MIT",
  "homepage": "https://github.com/PedroGomesFR/deadlock-blueprint",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroGomesFR/deadlock-blueprint.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "predev:vite": "npm run ocr-assets",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron . --dev",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "prebuild": "npm run ocr-assets",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vision": "npm run build && electron scripts/vision-replay.cjs --check tests/vision",
    "update-builds": "node scripts/update-builds.mjs",
    "update-street-brawl": "node scripts/update-street-brawl.mjs",
    "check-data": "node scripts/update-builds.mjs --check",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.vandicta.deadlock-blueprint",
    "productName": "Deadlock Blueprint",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "PedroGomesFR",
        "repo": "deadlock-blueprint",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Deadlock-Blueprint-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
